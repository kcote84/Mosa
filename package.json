{
  "name": "mosa-family",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "release:frame": "node scripts/prepare-frame-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "emulators": "firebase emulators:start --project demo-mosa --import .local/emulator-data --export-on-exit .local/emulator-data",
    "seed:local": "node scripts/seed.mjs --local --fixture",
    "test:integration": "node --test tests/integration.mjs"
  },
  "overrides": {
    "rollup": "4.52.5",
    "@grpc/grpc-js": "1.14.7"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.7"
  }
}
